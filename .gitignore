# Data (never commit the dataset itself)
data/

# Trained models, tracking, logs -- runtime-generated, not portable/reproducible
# (models/ also covers models/mlruns/, MLflow's tracking DB and artifacts)
models/
# defensive catch-all in case a stray db ever appears outside models/mlruns/
mlflow.db*
logs/
/_*.log

# docs/reports/ IS committed (see docs/MODEL_HISTORY.md, which embeds its charts)

# Secrets (keep the folder + its placeholder note, ignore only the real token)
.kaggle/*
!.kaggle/.gitkeep
.env

# Notebooks / Python
src/notebooks/.ipynb_checkpoints/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Spark
spark-warehouse/
derby.log

# Pytest cache (also self-excludes via its own nested .pytest_cache/.gitignore,
# but listed here explicitly so it's visible without opening that folder)
.pytest_cache/

# Claude Code agent worktree storage (tooling metadata, not project content)
.claude/
